# Copy this file to .env and fill in the values.
# See README.md for the full setup walkthrough for each service.
#
# Used by both Next.js (reads .env automatically) and the Prisma CLI
# (migrate/generate/studio only read .env, not .env.local) — keep
# everything in this one file rather than splitting it.

# --- Contact form (EmailJS, client-safe public keys) ---
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# --- Blog database (Vercel Postgres / Neon) ---
DATABASE_URL=

# --- Blog image uploads (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=

# --- Admin login (single admin, no separate user system) ---
# Random 32+ char string used to sign session cookies:
#   openssl rand -base64 32
AUTH_SECRET=
# Bcrypt hash of your chosen admin password (not the password itself):
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# IMPORTANT: bcrypt hashes start with $2b$10$... — Next.js's env loader does
# shell-style $VAR expansion and will silently mangle unescaped $ signs.
# Escape every $ as \$ when pasting the hash in, e.g.:
#   ADMIN_PASSWORD_HASH="\$2b\$10\$abc123..."
ADMIN_PASSWORD_HASH=
