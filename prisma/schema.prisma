generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  content     String
  coverImage  String?
  // Blog taxonomy (see src/lib/blog-taxonomy.ts):
  // category = section slug ("engineering" | "labs" | "life"),
  // topic    = topic slug inside that section (e.g. "kubernetes"),
  // tags     = free-form sub-topics, display text (e.g. "Scheduling").
  category    String    @default("engineering")
  topic       String?
  tags        String[]  @default([])
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([category, topic])
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  // "in-progress" | "completed" | "archived" — plain string, validated in app code.
  status      String   @default("in-progress")
  year        String
  stack       String[]
  // Cover/thumbnail image shown on the project card.
  image       String?
  // Additional case-study screenshots, shown in order.
  screenshots String[]
  problem     String
  approach    String
  features    String[]
  challenges  String
  outcome     String
  githubUrl   String?
  liveUrl     String?
  published   Boolean  @default(true)
  // Manual sort order for the homepage list (lower = shown first).
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Achievements (competitions, programs) and certifications, shown on the
// homepage under "Achievements & certifications". See src/lib/awards.ts.
model Award {
  id            String   @id @default(cuid())
  slug          String   @unique
  // "certification" | "achievement" — plain string, validated in app code.
  kind          String
  title         String
  // The outcome, e.g. "3rd Prize", "Finalist · Top 8", "Certified".
  result        String?
  // Organiser or certifying body, e.g. "The Linux Foundation".
  issuer        String?
  // Free text so it can be "2024", "Mar 2023" or "University · 3rd year".
  date          String?
  description   String   @default("")
  // Photos / certificate scans, shown in order; the first one is the card image.
  images        String[] @default([])
  credentialUrl String?
  credentialId  String?
  validUntil    String?
  published     Boolean  @default(true)
  // Manual sort order within its kind (lower = shown first).
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
